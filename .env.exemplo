# Copie para .env e troque os valores. O .env NAO e versionado (.gitignore).
#
# Senha do PostgreSQL do compose. Qualquer valor; vale so dentro do compose.
POSTGRES_PASSWORD=troque-esta-senha

# Segredo que assina os JWT (docs/adr/0012). Minimo 32 bytes; a API recusa
# subir com menos. Gere um:  openssl rand -base64 48
CRIPTO_JWT_SEGREDO=troque-por-um-segredo-aleatorio-com-pelo-menos-32-bytes
